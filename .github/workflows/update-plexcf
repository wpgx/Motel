name: Update Plex CA to motel/main

on:
  schedule:
    - cron: '0 6 * * *'  # daily 6am UTC
  workflow_dispatch:

jobs:
  update:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout main
        uses: actions/checkout@v4
        with:
          ref: main

      - name: Fetch from Cloudflare Worker (bypass GitHub block)
        run: |
          curl -L -A "Mozilla/5.0" -o plex-ca.m3u8 https://plex-ca.donxman.workers.dev/plex-ca.m3u8
          curl -L -A "Mozilla/5.0" -o plex-ca.xml https://plex-ca.donxman.workers.dev/plex-ca.xml
          
          # Also create .m3u copy for players that want .m3u
          cp plex-ca.m3u8 plex-ca.m3u

          echo "--- plex-ca.m3u8 ---"
          wc -l plex-ca.m3u8
          head -3 plex-ca.m3u8
          echo "--- plex-ca.xml ---"
          ls -lh plex-ca.xml

      - name: Commit to motel/main
        run: |
          git config user.name "plex-bot"
          git config user.email "bot@donxman.workers.dev"
          git add plex-ca.m3u8 plex-ca.m3u plex-ca.xml
          git diff --cached --quiet && echo "No changes" && exit 0
          git commit -m "Update plex-ca $(date -u +%Y-%m-%d)"
          git push origin main
