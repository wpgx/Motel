export default {
  async fetch(req) {
    const PLEX_TOKEN = "yrUN1zymWiCCh6_CZJUz";
    const LINEUP_ID = "5fc771debdb26c002ee25093";
    let url = new URL(req.url);
    let path = url.pathname;

    let r = await fetch("https://epg.provider.plex.tv/lineups/" + LINEUP_ID + "/channels?X-Plex-Token=" + PLEX_TOKEN, {
      headers: { "X-Plex-Token": PLEX_TOKEN }
    });
    let xml = await r.text();
    let matches = xml.match(/<Channel[^>]+\/>/g) || [];

    // Serve XMLTV for /plex-ca.xml
    if (path.endsWith(".xml")) {
      let xmltv = '<?xml version="1.0" encoding="UTF-8"?>\n<tv>\n';
      for (let tag of matches) {
        let get = (n) => { let m = tag.match(new RegExp(n + '="([^"]*)"')); return m? m[1] : ""; };
        let title = get("title");
        let id = get("id");
        xmltv += ` <channel id="${id}"><display-name>${title}</display-name></channel>\n`;
      }
      xmltv += '</tv>';
      return new Response(xmltv, { headers: { "Content-Type": "application/xml", "Access-Control-Allow-Origin": "*" } });
    }

    // Serve M3U for /, /plex-ca.m3u, /m3u
    let m3u = "#EXTM3U\n";
    for (let tag of matches) {
      let get = (n) => { let m = tag.match(new RegExp(n + '="([^"]*)"')); return m? m[1] : ""; };
      let title = get("title").replace(/,/g, " ");
      let vcn = get("vcn");
      let thumb = get("thumb");
      let id = get("id");
      m3u += '#EXTINF:-1 tvg-id="' + id + '" tvg-logo="' + thumb + '" tvg-chno="' + vcn + '" group-title="Canada Bell", ' + title + '\n';
      m3u += 'https://example.com/' + id + '\n';
    }
    return new Response("# Total " + matches.length + " channels\n" + m3u, {
      headers: { "Content-Type": "text/plain", "Access-Control-Allow-Origin": "*" }
    });
  }
}
